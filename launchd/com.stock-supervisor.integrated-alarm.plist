<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stock-supervisor.integrated-alarm</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/tothemoon/stock-supervisor/.venv/bin/python3</string>
        <string>/Users/tothemoon/stock-supervisor/integrated_alarm_engine.py</string>
        <string>--mode</string>
        <string>auto</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/tothemoon/stock-supervisor</string>

    <key>StartCalendarInterval</key>
    <array>
        <!-- 1. 08:30 KST : 🇰🇷 한국장 개장전 실전 포트폴리오 알람 (월~금) -->
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>

        <!-- 2. 15:00 KST : 🇰🇷 한국장 종가매수 최종 타깃 & 포트폴리오 알람 (월~금) -->
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>

        <!-- 3. 17:30 KST : 🇺🇸 미국장 장전 실전 포트폴리오 알람 (월~금) -->
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/tothemoon/stock-supervisor/data/launchd_alarm.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/tothemoon/stock-supervisor/data/launchd_alarm_err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
